# Environment Variables — SIH-26227
# Copy this file to .env and fill in values for your deployment.
# .env is gitignored — never commit secrets or personal paths.

# ==============================================================================
# CORE PATHS
# ==============================================================================

# Absolute path to the project root directory.
# Default: auto-detected from project_code/config.py using __file__ resolution.
# Override only if your datasets live outside the repository directory.
# Example: /mnt/data/sih-26227
PROJECT_ROOT=

# ==============================================================================
# API SERVER
# ==============================================================================

# FastAPI bind address and port
API_HOST=127.0.0.1
API_PORT=8000

# ==============================================================================
# FRONTEND (Node server.js)
# ==============================================================================

# Port for the production Node.js proxy server
PORT=3000

# FastAPI backend target for the proxy
API_TARGET=http://127.0.0.1:8000
